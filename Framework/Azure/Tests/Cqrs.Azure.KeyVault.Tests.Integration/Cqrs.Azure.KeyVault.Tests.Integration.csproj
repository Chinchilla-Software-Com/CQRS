		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="9.0.9" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="cqrs.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
